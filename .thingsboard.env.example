# Caminho do banco SQLite utilizado pelo scanner e pelo publicador
CRYPTO_DB_PATH=/home/pi4/crypto-quant-monitor/data/crypto_market.db

# URL local do ThingsBoard CE
TB_URL=http://127.0.0.1:8080

# Token de acesso do dispositivo "Crypto Quant Monitor"
# Substitua pelo token real no arquivo .thingsboard.env (não versionar).
TB_TOKEN=COLOQUE_O_TOKEN_AQUI

# Timeout HTTP em segundos
TB_HTTP_TIMEOUT=15

# Número máximo de ativos individuais publicados
TB_MAX_ASSETS=20
